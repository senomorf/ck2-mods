{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["tooling"],
  "commitMessagePrefix": "tooling:",
  "rebaseWhen": "behind-base-branch",
  "git-submodules": { "enabled": true },
  "customManagers": [
    {
      "customType": "regex",
      "description": "DepotDownloader pinned in the cloud setup script",
      "managerFilePatterns": ["/^tools/cloud_setup\\.sh$/"],
      "matchStrings": ["DEPOTDOWNLOADER_VERSION=(?<currentValue>\\S+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "SteamRE/DepotDownloader",
      "extractVersionTemplate": "^DepotDownloader_(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "CWTools CLI pinned in the cloud setup script",
      "managerFilePatterns": ["/^tools/cloud_setup\\.sh$/"],
      "matchStrings": ["CWTOOLS_CLI_VERSION=(?<currentValue>\\S+)"],
      "datasourceTemplate": "nuget",
      "depNameTemplate": "CWTools.CLI"
    }
  ]
}
